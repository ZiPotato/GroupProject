<article class="parcel-card @(Parcel.IsDelivered ? "parcel-card--delivered" : null)" @onclick="HandleUpdate">
    <div class="parcel-card__header">
        <div>
            <p class="parcel-card__eyebrow">Tracking number</p>
            <h2>@Parcel.TrackingId</h2>
        </div>

        <div>
            <button type="button" class="btn-danger" @onclick:stopPropagation="true" @onclick="HandleRemove"></button>
        </div>
    </div>

    <div class="parcel-card__grid">

        <a class="parcel-card__section parcel-card__section--Link" @onclick:stopPropagation="true" href="@($"https://{Parcel.Company}.fi")" target="_blank">
                <h3>Carrier</h3>
                <p>@Parcel.Company</p>
        </a>

        <section class="parcel-card__section">
            <h3>Status</h3>
            <p>@Parcel.StatusDescription</p>
        </section>

        <section class="parcel-card__section parcel-card__section--full">
            @if (Parcel.IsDelivered)
            {
                <h3>Package was delivered</h3>
                <p>@Parcel.DeliveredAt</p>
            }
            else
            {
                <h3>Estimated time of arrival</h3>
                @if (Parcel.ETA != null)
                {
                    <p>@Parcel.ETA</p>
                }
                else
                {
                    <p>We couldn't fetch the ETA for this package.</p>
                }
            }
        </section>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public Parcel Parcel { get; init; }

    [Parameter, EditorRequired]
    public EventCallback<Parcel> OnUpdateCallBack { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Parcel> OnRemoveCallBack { get; set; }

    private async Task HandleUpdate()
    {
        await OnUpdateCallBack.InvokeAsync(Parcel);
    }

    private async Task HandleRemove()
    {
        await OnRemoveCallBack.InvokeAsync(Parcel);
    }
}
