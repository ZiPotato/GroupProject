
<div class="body">
        <h2>@ParcelID</h2>
        <h3>The carrier of this package is: @ParcelCarrier</h3>
        <p>@ParcelState</p>
        @if(ParcelETA != null)
        {
            <p>Estimated time of arrival: @ParcelETA</p>
        }
        else 
        {
            <p>We couldn't fetch the ETA for this package.</p>
        }
</div>

@code {

    [Parameter, EditorRequired]
    public Parcel parcel { get; init; }

    string ParcelID;
    string ParcelState;
    string ParcelCarrier;
    DateTimeOffset? ParcelETA;

    public ParcelWidget() 
    {
        //ParcelID = Parcel.TrackingId ?? "Couldn't find the tracking ID";
        //ParcelCarrier = Parcel.Company ?? "Couldn't find the company";
        //ParcelState = Parcel.StatusDescription ?? "Couldn't find the status description";
        //ParcelETA = Parcel.DeliveredAt;


        // test values
        ParcelID = "AB12334";
        ParcelCarrier = "Matkahuolto";
        ParcelState = "In Delivery";
        ParcelETA = DateTimeOffset.Now;
    }
}
