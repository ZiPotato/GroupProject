@page "/"
@using LähetysSeurantaConsole.View;
@using LähetysSeurantaConsole.Presenter;
@using System.Text.RegularExpressions;
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<input class="ourtxt" type="text" @bind-value="ID"/>
<button class="ourbtn" @onclick="HandleAdd">Add a package</button>

<NotificationWidget @ref="notification" />

<!-- basic test loop -->
<div class="parcel-grid">
	@foreach (var parcel in parcelList)
	{
		<ParcelWidget Parcel="parcel" OnUpdateCallBack="UpdateParcelInfo" />
	}
</div>


@code {
	// replace this if we don't want to have the parcel list here

	private List<Parcel> parcelList = new() {}; // test null values

	private PackageModeling _modeling = new();

	private string ID { get; set; }

	private NotificationWidget notification;

	private async Task UpdateParcelInfo(Parcel parcel)
	{
		Parcel updatedParcel;
		try
		{
			updatedParcel = await _modeling.UpdateParcelAsync(parcel);
		}
		catch (Exception ex)
		{
			notification.Show(ex.Message, "Exception:");
			return;
		}

		var index = parcelList.FindIndex(p => p.TrackingId == parcel.TrackingId);
		if (index >= 0)
		{
			parcelList[index] = updatedParcel;
		}
	}

	private async Task HandleAdd()
	{
		try
		{
			string iD = ID;
			iD = iD.ToUpper().Trim();
			char[] iDarray = iD.ToCharArray();

			if (string.IsNullOrEmpty(iD)) throw new ArgumentNullException("ID cannot be null or empty");

			// MH302164795FI

			Regex reg = new Regex(@"\d");

			if (!char.IsLetter(iDarray[0]) && !char.IsLetter(iDarray[1]) ||
				!char.IsLetter(iDarray[iDarray.Length - 1]) && !char.IsLetter(iDarray[iDarray.Length - 2])||
				reg.Count(iDarray) <= 2)
			{
				throw new ArgumentException("Invalid tracking number");
			}

			Parcel p = await _modeling.GetTheParcelAsync(iD);
			parcelList.Add(p);
			Console.WriteLine($"Success\nParcel: \n{p}\nWas added.");

		}
		catch (Exception ex)
		{
			Console.WriteLine($"Exception: {ex.Message}");
			notification.Show(ex.Message, "Exception:");
		}
	}
}