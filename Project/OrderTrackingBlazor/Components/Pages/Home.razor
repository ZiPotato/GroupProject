@page "/"
@using CoreValidation = OrderTracking.Core.Validation.TrackingIDValidation
@using OrderTracking.Core.Services
@using OrderTracking.Core.Models.Package.Fetched
@inject ParcelState state
@rendermode InteractiveServer
@inject ITrackingValidation Validation

<PageTitle>Home</PageTitle>
<div class="inputs">
	<input class="ourtxt" type="text" @bind-value="ID" placeholder="Insert tracking ID here"/>
	<button class="ourbtn" @onclick="HandleAdd">Add a package</button>
</div>

<NotificationWidget @ref="notification" />

<div class="parcel-grid">
	@foreach (var parcel in state.ActiveParcels)
	{
		<ParcelWidget Parcel="parcel" OnUpdateCallBack="UpdateParcelInfo" OnRemoveCallBack="RemoveParcel" />
	}
</div>

@code {
	private List<Parcel> parcelList = new();

	private CoreValidation _validation = new();

	private string ID { get; set; } = "";
	private NotificationWidget notification = default!;

	private NotificationWidget notification;

	private async Task UpdateParcelInfo(Parcel parcel)
	{
		Parcel updatedParcel;
		try
		{
			updatedParcel = await _validation.ValidateParcelUpdate(parcel);
			state.RemoveParcel(parcel);
			state.SaveParcel(updatedParcel);
		}
		catch (Exception ex)
		{
			notification.Show(ex.Message, "Update Exception:");
			return;
		}

		var index = state.ActiveParcels.FindIndex(p => p.TrackingId == parcel.TrackingId);
		if (index >= 0)
		{
			state.ActiveParcels[index] = updatedParcel;
		}
		if (updatedParcel.IsDelivered)
		{
			state.ActiveParcels.Remove(state.ActiveParcels[index]);
			state.DeliveredParcels.Add(updatedParcel);
			notification.Show("Parcel delivered");
			return;
		}
	}

	private Task RemoveParcel(Parcel parcel)
	{
		try
		{
			string removedID = parcel.TrackingId;
			state.ActiveParcels.Remove(parcel);
			state.RemoveParcel(parcel);
			notification.Show($"Removed parcel with ID: {removedID}", "Succsess!");
		}
		catch (Exception ex)
		{
			notification.Show(ex.Message, "Remove Exception:");
		}

		return Task.CompletedTask;
	}

	private async Task HandleAdd()
	{
		try
		{
			Parcel p = await _validation.ValidateNewTrackingId(ID);
			state.ActiveParcels.Add(p);
			state.SaveParcel(p);
			Console.WriteLine($"Success\nParcel: \n{p}\nWas added.");
		}
		catch (Exception ex)
		{
			notification.Show(ex.Message, "Add Exception:");
		}
	}
}